@using Microsoft.AspNetCore.Components.Authorization
@inject IStringLocalizer<SharedResource> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">ContosoDashboard</a>
    </div>
</div>

<input type="checkbox" title="@(L["Navigation menu"])" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> @L["Dashboard"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tasks">
                <span class="bi bi-check2-square" aria-hidden="true"></span> @L["My Tasks"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="projects">
                <span class="bi bi-folder" aria-hidden="true"></span> @L["My Projects"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documents">
                <span class="bi bi-file-earmark-text" aria-hidden="true"></span> @L["My Documents"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="documents/shared">
                <span class="bi bi-share" aria-hidden="true"></span> @L["Shared with Me"]
            </NavLink>
        </div>

        <AuthorizeView Roles="Administrator">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="documents/reports">
                    <span class="bi bi-bar-chart" aria-hidden="true"></span> @L["Document Reports"]
                </NavLink>
            </div>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="team">
                <span class="bi bi-people" aria-hidden="true"></span> @L["Team"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                <span class="bi bi-bell" aria-hidden="true"></span> @L["Notifications"]
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="profile">
                <span class="bi bi-person" aria-hidden="true"></span> @L["Profile"]
            </NavLink>
        </div>
    </nav>
    <div class="px-3 pb-3">
        <LanguageSelector />
    </div>
</div>

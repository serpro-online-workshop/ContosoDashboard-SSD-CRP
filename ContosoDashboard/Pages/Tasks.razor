@page "/tasks"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject ITaskService TaskService
@inject IProjectService ProjectService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["My Tasks"] - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col">
            <h1>@L["My Tasks"]</h1>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="ShowCreateTaskModal">
                <i class="bi bi-plus-circle"></i> @L["New Task"]
            </button>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-4">
        <div class="col-md-3">
            <label>@L["Status"]</label>
            <select class="form-select" @bind="filterStatus">
                <option value="">@L["All"]</option>
                <option value="@Models.TaskStatus.NotStarted">@L["Not Started"]</option>
                <option value="@Models.TaskStatus.InProgress">@L["In Progress"]</option>
                <option value="@Models.TaskStatus.Completed">@L["Completed"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>@L["Priority"]</label>
            <select class="form-select" @bind="filterPriority">
                <option value="">@L["All"]</option>
                <option value="@TaskPriority.Low">@L["Low"]</option>
                <option value="@TaskPriority.Medium">@L["Medium"]</option>
                <option value="@TaskPriority.High">@L["High"]</option>
                <option value="@TaskPriority.Critical">@L["Critical"]</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button class="btn btn-secondary d-block w-100" @onclick="ApplyFilters">
                @L["Apply Filters"]
            </button>
        </div>
    </div>

    <!-- Tasks List -->
    @if (tasks == null)
    {
        <p><em>@L["Loading..."]</em></p>
    }
    else if (!tasks.Any())
    {
        <div class="alert alert-info">@L["No tasks found."]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>@L["Title"]</th>
                        <th>@L["Priority"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["Due Date"]</th>
                        <th>@L["Project"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in tasks)
                    {
                        <tr>
                            <td>
                                <strong>@L[task.Title]</strong>
                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <br />
                                    <small class="text-muted">@L[task.Description]</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-@GetPriorityColor(task.Priority)">
                                    @L[task.Priority.ToString()]
                                </span>
                            </td>
                            <td>
                                <select class="form-select form-select-sm" 
                                        value="@task.Status" 
                                        @onchange="@(e => UpdateTaskStatus(task.TaskId, Enum.Parse<Models.TaskStatus>(e.Value?.ToString() ?? "NotStarted")))">
                                    <option value="@Models.TaskStatus.NotStarted">@L["Not Started"]</option>
                                    <option value="@Models.TaskStatus.InProgress">@L["In Progress"]</option>
                                    <option value="@Models.TaskStatus.Completed">@L["Completed"]</option>
                                </select>
                            </td>
                            <td>
                                @if (task.DueDate.HasValue)
                                {
                                    var isOverdue = task.DueDate.Value < DateTime.UtcNow && task.Status != Models.TaskStatus.Completed;
                                    <span class="@(isOverdue ? "text-danger fw-bold" : "")">
                                        @task.DueDate.Value.ToString("d")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">@L["No due date"]</span>
                                }
                            </td>
                            <td>
                                @if (task.Project != null)
                                {
                                    <a href="/projects/@task.ProjectId">@L[task.Project.Name]</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewTaskDetails(task.TaskId)">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showCreateTaskModal)
{
    <div class="modal-backdrop fade show" @onclick="CloseCreateTaskModal"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["Create Task"]</h5>
                    <button type="button" class="btn-close" aria-label="@L["Close"]" @onclick="CloseCreateTaskModal"></button>
                </div>
                <EditForm Model="@newTask" OnValidSubmit="CreateTask">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <ValidationSummary />
                        @if (!string.IsNullOrEmpty(taskCreationError))
                        {
                            <div class="alert alert-danger" role="alert">@taskCreationError</div>
                        }
                        <div class="mb-3">
                            <label class="form-label" for="task-title">@L["Task Title"]</label>
                            <InputText id="task-title" class="form-control" @bind-Value="newTask.Title" maxlength="255" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="task-description">@L["Description"]</label>
                            <InputTextArea id="task-description" class="form-control" @bind-Value="newTask.Description" maxlength="2000" rows="3" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="task-priority">@L["Priority"]</label>
                                <InputSelect id="task-priority" class="form-select" @bind-Value="newTask.Priority">
                                    <option value="@TaskPriority.Low">@L["Low"]</option>
                                    <option value="@TaskPriority.Medium">@L["Medium"]</option>
                                    <option value="@TaskPriority.High">@L["High"]</option>
                                    <option value="@TaskPriority.Critical">@L["Critical"]</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="task-due-date">@L["Due Date"]</label>
                                <InputDate id="task-due-date" class="form-control" @bind-Value="dueDate" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="task-project">@L["Project (Optional)"]</label>
                            @if (isLoadingProjects)
                            {
                                <div class="form-text">@L["Loading..."]</div>
                            }
                            else
                            {
                                <InputSelect id="task-project" class="form-select" @bind-Value="selectedProjectId">
                                    <option value="">@L["No project"]</option>
                                    @foreach (var project in userProjects)
                                    {
                                        <option value="@project.ProjectId">@L[project.Name]</option>
                                    }
                                </InputSelect>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreateTaskModal">@L["Cancel"]</button>
                        <button type="submit" class="btn btn-primary" disabled="@isCreatingTask">
                            @(isCreatingTask ? L["Creating..."] : L["Create"])
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<TaskItem>? tasks;
    private List<Project> userProjects = new();
    private TaskItem newTask = new();
    private string filterStatus = "";
    private string filterPriority = "";
    private string selectedProjectId = "";
    private DateTime? dueDate;
    private string? taskCreationError;
    private bool showCreateTaskModal;
    private bool isLoadingProjects;
    private bool isCreatingTask;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            await LoadTasks();
        }
    }

    private async Task LoadTasks()
    {
        tasks = await TaskService.GetUserTasksAsync(currentUserId);
    }

    private async Task ApplyFilters()
    {
        Models.TaskStatus? status = string.IsNullOrEmpty(filterStatus) ? null : Enum.Parse<Models.TaskStatus>(filterStatus);
        TaskPriority? priority = string.IsNullOrEmpty(filterPriority) ? null : Enum.Parse<TaskPriority>(filterPriority);

        tasks = await TaskService.GetFilteredTasksAsync(currentUserId, status, priority, null);
    }

    private async Task UpdateTaskStatus(int taskId, Models.TaskStatus newStatus)
    {
        if (currentUserId > 0)
        {
            await TaskService.UpdateTaskStatusAsync(taskId, currentUserId, newStatus);
            await LoadTasks();
        }
    }

    private async Task ShowCreateTaskModal()
    {
        if (currentUserId <= 0)
        {
            return;
        }

        newTask = new TaskItem();
        selectedProjectId = "";
        dueDate = null;
        taskCreationError = null;
        showCreateTaskModal = true;
        isLoadingProjects = true;

        try
        {
            userProjects = await ProjectService.GetUserProjectsAsync(currentUserId);
        }
        catch
        {
            userProjects = new List<Project>();
            taskCreationError = L["Could not load projects. You can still create a task without a project."];
        }
        finally
        {
            isLoadingProjects = false;
        }
    }

    private void CloseCreateTaskModal()
    {
        showCreateTaskModal = false;
        taskCreationError = null;
    }

    private async Task CreateTask()
    {
        if (currentUserId <= 0 || isCreatingTask)
        {
            return;
        }

        isCreatingTask = true;
        taskCreationError = null;
        newTask.AssignedUserId = currentUserId;
        newTask.CreatedByUserId = currentUserId;
        newTask.Status = Models.TaskStatus.NotStarted;
        newTask.DueDate = dueDate.HasValue
            ? DateTime.SpecifyKind(dueDate.Value.Date, DateTimeKind.Utc)
            : null;
        newTask.ProjectId = int.TryParse(selectedProjectId, out var projectId) ? projectId : null;

        try
        {
            await TaskService.CreateTaskAsync(newTask);
            filterStatus = "";
            filterPriority = "";
            await LoadTasks();
            showCreateTaskModal = false;
        }
        catch
        {
            taskCreationError = L["Could not create task. Try again."];
        }
        finally
        {
            isCreatingTask = false;
        }
    }

    private void ViewTaskDetails(int taskId)
    {
        NavigationManager.NavigateTo($"/tasks/{taskId}");
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Critical => "danger",
            TaskPriority.High => "warning",
            TaskPriority.Medium => "info",
            TaskPriority.Low => "secondary",
            _ => "secondary"
        };
    }
}

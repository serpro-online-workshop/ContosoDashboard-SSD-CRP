@page
@using System.Globalization
@using ContosoDashboard
@using Microsoft.Extensions.Localization
@model ContosoDashboard.Pages.LoginModel
@inject IStringLocalizer<SharedResource> L
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@L["Login"] - ContosoDashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row justify-content-center" style="margin-top: 100px;">
            <div class="col-md-6 col-lg-4">
                <div class="card shadow">
                    <div class="card-body p-5">
                        <form action="/culture/set" method="get" class="d-flex justify-content-end mb-3">
                            <input type="hidden" name="returnUrl" value="@($"{Request.Path}{Request.QueryString}")" />
                            <label class="visually-hidden" for="login-language">@L["Language"]</label>
                            <select id="login-language" name="culture" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                                <option value="en-US" selected="@(CultureInfo.CurrentUICulture.Name == "en-US" ? "selected" : null)">English</option>
                                <option value="pt-BR" selected="@(CultureInfo.CurrentUICulture.Name == "pt-BR" ? "selected" : null)">Português (Brasil)</option>
                                <option value="es" selected="@(CultureInfo.CurrentUICulture.Name == "es" ? "selected" : null)">Español</option>
                                <option value="de" selected="@(CultureInfo.CurrentUICulture.Name == "de" ? "selected" : null)">Deutsch</option>
                            </select>
                        </form>

                        <div class="text-center mb-4">
                            <h2>ContosoDashboard</h2>
                            <p class="text-muted">@L["Training Environment - Mock Login"]</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @Model.ErrorMessage
                            </div>
                        }

                        <form method="post">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label class="form-label">@L["Select User"]</label>
                                <select class="form-select" name="selectedUserId" required>
                                    <option value="0">@L["-- Choose a user to login as --"]</option>
                                    @if (Model.Users != null)
                                    {
                                        @foreach (var user in Model.Users)
                                        {
                                            <option value="@user.UserId">@user.DisplayName (@L[user.Role.ToString()])</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">
                                    @L["Login"]
                                </button>
                            </div>
                        </form>

                        <div class="alert alert-info mt-4" role="alert">
                            <small>
                                <strong>@L["Note:"]</strong> @L["This is a mock authentication system for training purposes only. Simply select a user to simulate logging in with that account."]
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>

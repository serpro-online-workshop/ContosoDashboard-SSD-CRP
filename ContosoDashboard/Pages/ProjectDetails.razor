@page "/projects/{projectId:int}"
@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@inject IProjectService ProjectService
@inject IDocumentService DocumentService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<SharedResource> L

<PageTitle>@L["Project Details"] - ContosoDashboard</PageTitle>

<div class="container-fluid">
    @if (project == null)
    {
        <p><em>@L["Loading..."]</em></p>
    }
    else
    {
        <div class="row mb-4">
            <div class="col">
                <nav aria-label="@L["Breadcrumb"]">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/projects">@L["My Projects"]</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@project.Name</li>
                    </ol>
                </nav>
                <h1>@L[project.Name]</h1>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">@L["Project Information"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="text-muted small">@L["Description"]</label>
                                <p>@(project.Description is null ? string.Empty : L[project.Description].Value)</p>
                            </div>
                            <div class="col-md-3">
                                <label class="text-muted small">@L["Status"]</label>
                                <p>
                                    <span class="badge bg-@GetStatusColor(project.Status)">
                                        @L[project.Status.ToString()]
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-3">
                                <label class="text-muted small">@L["Progress:"]</label>
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar" 
                                         style="width: @project.CompletionPercentage%"
                                         aria-valuenow="@project.CompletionPercentage" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        @project.CompletionPercentage%
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="text-muted small">@L["Project Manager"]</label>
                                <p>@project.ProjectManager.DisplayName</p>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small">@L["Start Date"]</label>
                                <p>@project.StartDate.ToString("d")</p>
                            </div>
                            <div class="col-md-4">
                                <label class="text-muted small">@L["Target Completion"]</label>
                                <p>
                                    @if (project.TargetCompletionDate.HasValue)
                                    {
                                        <span>@project.TargetCompletionDate.Value.ToString("d")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@L["Not set"]</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">@L["Project Tasks"]</h5>
                    </div>
                    <div class="card-body">
                        @if (!project.Tasks.Any())
                        {
                            <p class="text-muted">@L["No tasks assigned to this project."]</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>@L["Title"]</th>
                                            <th>@L["Assigned To"]</th>
                                            <th>@L["Status"]</th>
                                            <th>@L["Priority"]</th>
                                            <th>@L["Due Date"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var task in project.Tasks.OrderBy(t => t.DueDate))
                                        {
                                            <tr class="@(task.DueDate.HasValue && task.DueDate < DateTime.Today && task.Status != Models.TaskStatus.Completed ? "table-danger" : "")">">
                                                <td>
                                                    <strong>@L[task.Title]</strong>
                                                    @if (!string.IsNullOrEmpty(task.Description))
                                                    {
                                                        <br />
                                                        <small class="text-muted">@L[task.Description]</small>
                                                    }
                                                </td>
                                                <td>@task.AssignedUser.DisplayName</td>
                                                <td>
                                                    <span class="badge bg-@GetTaskStatusColor(task.Status)">
                                                        @L[task.Status.ToString()]
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-@GetPriorityColor(task.Priority)">
                                                        @L[task.Priority.ToString()]
                                                    </span>
                                                </td>
                                                <td>
                                                    @(task.DueDate?.ToString("d") ?? L["No due date"].Value)
                                                    @if (task.DueDate.HasValue && task.DueDate < DateTime.Today && task.Status != Models.TaskStatus.Completed)
                                                    {
                                                        <span class="text-danger ms-1">
                                                            <i class="bi bi-exclamation-triangle"></i> @L["Overdue"]
                                                        </span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-header">
                        <h5 class="mb-0">@L["Project Documents"]</h5>
                    </div>
                    <div class="card-body">
                        @if (_projectDocuments is null)
                        {
                            <p><em>@L["Loading..."]</em></p>
                        }
                        else if (_projectDocuments.Count == 0)
                        {
                            <p class="text-muted mb-0">@L["No project documents found."]</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">@L["Title"]</th>
                                            <th scope="col">@L["Category"]</th>
                                            <th scope="col">@L["Uploaded"]</th>
                                            <th scope="col"><span class="visually-hidden">@L["Actions"]</span></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var document in _projectDocuments)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@document.Title</strong>
                                                    <div class="small text-muted">@document.OriginalFileName</div>
                                                </td>
                                                <td>@L[document.Category]</td>
                                                <td>@document.UploadedAtUtc.ToLocalTime().ToString("d", CultureInfo.CurrentCulture)</td>
                                                <td class="text-nowrap">
                                                    @if (CanPreview(document.ContentType))
                                                    {
                                                        <a class="btn btn-sm btn-outline-secondary" href="@ContentUrl(document, "inline")" target="_blank" rel="noopener" title="@L["Preview"]" aria-label="@L["Preview {0}", document.Title]">
                                                            <span class="bi bi-eye" aria-hidden="true"></span>
                                                        </a>
                                                    }
                                                    <a class="btn btn-sm btn-outline-secondary" href="@ContentUrl(document, "attachment")" title="@L["Download"]" aria-label="@L["Download {0}", document.Title]">
                                                        <span class="bi bi-download" aria-hidden="true"></span>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">@L["Team Members"]</h5>
                    </div>
                    <div class="card-body">
                        @if (!project.ProjectMembers.Any())
                        {
                            <p class="text-muted">@L["No team members assigned."]</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var member in project.ProjectMembers.OrderBy(m => m.User.DisplayName))
                                {
                                    <div class="list-group-item px-0">
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(member.User.ProfilePhotoUrl))
                                            {
                                                <img src="@member.User.ProfilePhotoUrl" 
                                                     alt="@member.User.DisplayName" 
                                                     class="rounded-circle me-2" 
                                                     style="width: 40px; height: 40px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2"
                                                     style="width: 40px; height: 40px; font-size: 16px;">
                                                    @GetInitials(member.User.DisplayName)
                                                </div>
                                            }
                                            <div class="flex-grow-1">
                                                <div>
                                                    <strong>@member.User.DisplayName</strong>
                                                </div>
                                                <small class="text-muted">@L[member.Role]</small>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">@L["Statistics"]</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small">@L["Total Tasks"]</label>
                            <h4>@project.Tasks.Count</h4>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">@L["Completed Tasks"]</label>
                            <h4>@project.Tasks.Count(t => t.Status == Models.TaskStatus.Completed)</h4>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">@L["In Progress"]</label>
                            <h4>@project.Tasks.Count(t => t.Status == Models.TaskStatus.InProgress)</h4>
                        </div>
                        <div class="mb-3">
                            <label class="text-muted small">@L["Overdue Tasks"]</label>
                            <h4 class="@(project.Tasks.Count(t => t.DueDate.HasValue && t.DueDate < DateTime.Today && t.Status != Models.TaskStatus.Completed) > 0 ? "text-danger" : "")">
                                @project.Tasks.Count(t => t.DueDate.HasValue && t.DueDate < DateTime.Today && t.Status != Models.TaskStatus.Completed)
                            </h4>
                        </div>
                        <div>
                            <label class="text-muted small">@L["Team Size"]</label>
                            <h4>@project.ProjectMembers.Count</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int ProjectId { get; set; }

    private Project? project;
    private IReadOnlyList<Document>? _projectDocuments;
    private int currentUserId = 0;

    protected override async Task OnInitializedAsync()
    {
        // Get current user ID from authentication claims
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier);
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out int userId))
        {
            currentUserId = userId;
        }

        if (currentUserId > 0)
        {
            project = await ProjectService.GetProjectByIdAsync(ProjectId, currentUserId);
            if (project is not null)
            {
                var result = await DocumentService.SearchAsync(new DocumentSearchQuery
                {
                    ProjectId = ProjectId,
                    SortBy = DocumentSortField.UploadedAtUtc,
                    Descending = true,
                    Page = 1,
                    PageSize = 500
                }, currentUserId);
                _projectDocuments = result.Items;
            }
        }
        
        if (project == null)
        {
            NavigationManager.NavigateTo("/projects");
        }
    }

    private string GetStatusColor(ProjectStatus status)
    {
        return status switch
        {
            ProjectStatus.Planning => "secondary",
            ProjectStatus.Active => "primary",
            ProjectStatus.OnHold => "warning",
            ProjectStatus.Completed => "success",
            _ => "secondary"
        };
    }

    private static bool CanPreview(string contentType) => contentType is "application/pdf" or "image/jpeg" or "image/png";

    private static string ContentUrl(Document document, string disposition) => $"/documents/{document.DocumentId}/content?disposition={disposition}";

    private string GetTaskStatusColor(Models.TaskStatus status)
    {
        return status switch
        {
            Models.TaskStatus.NotStarted => "secondary",
            Models.TaskStatus.InProgress => "primary",
            Models.TaskStatus.Completed => "success",
            _ => "secondary"
        };
    }

    private string GetPriorityColor(TaskPriority priority)
    {
        return priority switch
        {
            TaskPriority.Low => "secondary",
            TaskPriority.Medium => "info",
            TaskPriority.High => "warning",
            TaskPriority.Critical => "danger",
            _ => "secondary"
        };
    }

    private string GetInitials(string displayName)
    {
        var names = displayName.Split(' ');
        if (names.Length >= 2)
        {
            return $"{names[0][0]}{names[1][0]}".ToUpper();
        }
        return displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "?";
    }
}
